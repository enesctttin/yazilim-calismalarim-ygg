@model IEnumerable<denemeSql.Models.Course>

<h2>Ders Listesi</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Yeni Ders Ekle</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Ders Adı</th>
            <th>Dersi Veren Akademisyen</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Title</td>
                <td>@item.Academician.Name</td>
            </tr>
        }
    </tbody>
</table>