@model denemeSql.Models.Academician

@{
    ViewData["Title"] = "Yeni Akademisyen Ekle";
}

<h2>Yeni Akademisyen Ekle</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label">Akademisyen Adı Soyadı</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <input type="submit" value="Kaydet" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>

        </form>
    </div>
</div>