@model IEnumerable<denemeSql.Models.Academician>

@{
    ViewData["Title"] = "Akademisyen Listesi";
}

<h2>Sistemdeki Akademisyenler</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Akademisyen Ekle</a>
</p>

<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>ID</th>
            <th>Adı Soyadı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>